# Required API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FISH_API_KEY=your-fish-audio-api-key-here

# Optional: Fish Audio voice model (defaults to DOBBY MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Your name (도비일번 will address you by name)
# USER_NAME=Tony

# Optional: Specific Apple Calendar accounts to read (comma-separated emails)
# If not set, 도비일번 reads ALL calendars from Apple Calendar
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com

# macOS say 음성 (기본: Yuna = 한국어, 다른 옵션: Eddy, Reed, Sandy, Flo, Shelley)
# 사용 가능한 음성 목록: say -v '?' | grep ko_KR
# SAY_VOICE=Yuna

# Motion Control (기본 OFF — 명시적으로 켜야 활성화됨)
# MOTION_CONTROL_ENABLED=false
