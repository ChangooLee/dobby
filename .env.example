# ─────────────────────────────────────────────────────────────
# DOBBY — 환경 변수 예시
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── AI API ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
USER_NAME=주인님

# ── TTS: Qwen3 (로컬 우선, 실패 시 macOS say로 폴백) ──────────
QWEN3_TTS_URL=http://localhost:8000/v1
QWEN3_TTS_KEY=your-qwen3-key-here
QWEN3_TTS_VOICE=serena
QWEN3_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-bf16

# Qwen3 사용 불가 시 macOS say 폴백 음성
SAY_VOICE=Yuna

# ── Motion Control ────────────────────────────────────────────
# 시작 시 모션 제어 기본값 (true/false)
MOTION_CONTROL_ENABLED=false

# ── Claude Code ───────────────────────────────────────────────
# claude 실행 파일 경로 (비워두면 자동 탐색)
# 자동 탐색 순서: which claude → /opt/homebrew/bin/claude → ~/.npm-global/bin/claude 등
# CLAUDE_BIN=/opt/homebrew/bin/claude

# ── Desktop / Space 전환 ──────────────────────────────────────
# auto|applescript|pyautogui
# auto: pyautogui 우선, 실패 시 osascript 폴백
DESKTOP_SWITCH_METHOD=auto

# ── Debug ─────────────────────────────────────────────────────
# DOBBY_DEBUG_MOTION=true
# DOBBY_DEBUG_CLAUDE=true

# ── Calendar ─────────────────────────────────────────────────
# 쉼표로 구분된 캘린더 이메일 목록 (Apple Calendar 연동)
# CALENDAR_ACCOUNTS=me@example.com,work@example.com
