#!/usr/bin/env bash
# ─────────────────────────────────────────────
#  DOBBY System Manager
#  Usage: dobby [start|stop|restart|status|logs] [backend|tts|hud]
# ─────────────────────────────────────────────
set -uo pipefail

DOBBY_DIR="$(cd "$(dirname "$0")" && pwd)"
TTS_DIR="$HOME/Workspace/qwen3-tts-server"

LOG_BACKEND="/tmp/dobby_server.log"
LOG_TTS="/tmp/qwen_tts.log"
LOG_HUD="/tmp/hud.log"

# ── 색상 ──────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

ok()   { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}!${NC} $*"; }
err()  { echo -e "${RED}✗${NC} $*"; }
hdr()  { echo -e "\n${BOLD}${CYAN}$*${NC}"; }

# ── 상태 체크 ─────────────────────────────────
_backend_pid() { lsof -ti :8340 2>/dev/null | head -1 || true; }
_tts_pid()     { lsof -ti :8000 2>/dev/null | head -1 || true; }
_hud_pid()     { pgrep -f "electron dist/main.js" 2>/dev/null | head -1 || true; }

_is_running() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# ── 개별 시작 함수 ────────────────────────────
start_backend() {
  if _is_running "$(_backend_pid)"; then
    warn "Backend 이미 실행 중 (port 8340)"
    return
  fi
  echo -n "  Backend 시작..."
  cd "$DOBBY_DIR"
  nohup .venv/bin/python server.py > "$LOG_BACKEND" 2>&1 &
  # 포트 열릴 때까지 대기 (최대 8초)
  local i=0
  while ! lsof -ti :8340 &>/dev/null; do
    sleep 0.5; ((i++))
    [[ $i -ge 16 ]] && { err " 시작 실패 (로그: $LOG_BACKEND)"; return 1; }
  done
  ok " PID $(_backend_pid)"
}

start_tts() {
  if _is_running "$(_tts_pid)"; then
    warn "Qwen3 TTS 이미 실행 중 (port 8000)"
    return
  fi
  echo -n "  Qwen3 TTS 서버 시작..."
  nohup "$TTS_DIR/bin/python" "$TTS_DIR/server.py" > "$LOG_TTS" 2>&1 &
  # 포트 열릴 때까지 대기
  local i=0
  while ! lsof -ti :8000 &>/dev/null; do
    sleep 0.5; ((i++))
    [[ $i -ge 16 ]] && { err " 시작 실패 (로그: $LOG_TTS)"; return 1; }
  done
  ok " PID $(_tts_pid)"
  warn "  첫 번째 TTS 요청 시 모델 자동 로드 (~10초)"
}

start_hud() {
  if _is_running "$(_hud_pid)"; then
    warn "Motion HUD 이미 실행 중"
    return
  fi
  echo -n "  Motion HUD 시작..."
  cd "$DOBBY_DIR/motion-hud"
  npm start &> "$LOG_HUD" &
  sleep 2
  if _is_running "$(_hud_pid)"; then
    ok " PID $(_hud_pid)"
  else
    err " 시작 실패 (로그: $LOG_HUD)"
    return 1
  fi
}

# ── 개별 종료 함수 ────────────────────────────
stop_backend() {
  local pid; pid=$(_backend_pid)
  if [[ -z "$pid" ]]; then warn "Backend 실행 중 아님"; return; fi
  kill "$pid" 2>/dev/null
  ok "Backend 종료 (PID $pid)"
}

stop_tts() {
  local pid; pid=$(_tts_pid)
  if [[ -z "$pid" ]]; then warn "Qwen3 TTS 실행 중 아님"; return; fi
  kill "$pid" 2>/dev/null
  ok "Qwen3 TTS 종료 (PID $pid)"
}

stop_hud() {
  local pid; pid=$(_hud_pid)
  if [[ -z "$pid" ]]; then warn "Motion HUD 실행 중 아님"; return; fi
  pkill -f "electron dist/main.js" 2>/dev/null
  ok "Motion HUD 종료"
}

# ── 메인 커맨드 ───────────────────────────────
cmd_start() {
  local target="${1:-all}"
  hdr "▶  DOBBY 시작 — $target"
  case "$target" in
    all)     start_backend; start_tts; start_hud ;;
    backend) start_backend ;;
    tts)     start_tts ;;
    hud)     start_hud ;;
    *) err "알 수 없는 대상: $target"; exit 1 ;;
  esac
}

cmd_stop() {
  local target="${1:-all}"
  hdr "■  DOBBY 종료 — $target"
  case "$target" in
    all)     stop_hud; stop_tts; stop_backend ;;
    backend) stop_backend ;;
    tts)     stop_tts ;;
    hud)     stop_hud ;;
    *) err "알 수 없는 대상: $target"; exit 1 ;;
  esac
}

cmd_restart() {
  local target="${1:-all}"
  cmd_stop "$target"
  sleep 0.5
  cmd_start "$target"
}

cmd_status() {
  hdr "●  DOBBY 상태"
  local backend_pid; backend_pid=$(_backend_pid)
  local tts_pid;     tts_pid=$(_tts_pid)
  local hud_pid;     hud_pid=$(_hud_pid)

  if _is_running "$backend_pid"; then
    ok "Backend     실행 중 (PID $backend_pid, port 8340)"
  else
    err "Backend     중지됨"
  fi

  if _is_running "$tts_pid"; then
    ok "Qwen3 TTS  실행 중 (PID $tts_pid, port 8000)"
  else
    err "Qwen3 TTS  중지됨"
  fi

  if _is_running "$hud_pid"; then
    ok "Motion HUD 실행 중 (PID $hud_pid)"
  else
    err "Motion HUD 중지됨"
  fi
  echo
}

cmd_logs() {
  local target="${1:-}"
  case "$target" in
    backend) tail -f "$LOG_BACKEND" ;;
    tts)     tail -f "$LOG_TTS" ;;
    hud)     tail -f "$LOG_HUD" ;;
    ""|all)
      echo -e "${BOLD}=== Backend ===${NC}"
      tail -20 "$LOG_BACKEND" 2>/dev/null || true
      echo -e "\n${BOLD}=== Qwen3 TTS ===${NC}"
      tail -10 "$LOG_TTS" 2>/dev/null || true
      echo -e "\n${BOLD}=== Motion HUD ===${NC}"
      tail -10 "$LOG_HUD" 2>/dev/null | grep -v "Security Warning\|For more\|electronjs\|once the app\|This warning\|exposes users\|This renderer" || true
      ;;
    *) err "알 수 없는 대상: $target"; exit 1 ;;
  esac
}

cmd_help() {
  echo -e "${BOLD}DOBBY System Manager${NC}"
  echo
  echo "사용법: dobby <커맨드> [대상]"
  echo
  echo "커맨드:"
  echo "  start   [all|backend|tts|hud]  — 시작 (기본: all)"
  echo "  stop    [all|backend|tts|hud]  — 종료 (기본: all)"
  echo "  restart [all|backend|tts|hud]  — 재시작 (기본: all)"
  echo "  status                          — 실행 상태 확인"
  echo "  logs    [backend|tts|hud]       — 로그 확인"
  echo
  echo "예시:"
  echo "  dobby start          # 전체 시작"
  echo "  dobby restart hud    # HUD만 재시작"
  echo "  dobby logs tts       # TTS 로그 실시간"
  echo "  dobby status         # 상태 확인"
}

# ── 진입점 ────────────────────────────────────
CMD="${1:-help}"
shift 2>/dev/null || true
TARGET="${1:-}"

case "$CMD" in
  start)   cmd_start   "$TARGET" ;;
  stop)    cmd_stop    "$TARGET" ;;
  restart) cmd_restart "$TARGET" ;;
  status)  cmd_status ;;
  logs)    cmd_logs    "$TARGET" ;;
  help|-h|--help) cmd_help ;;
  *) err "알 수 없는 커맨드: $CMD"; cmd_help; exit 1 ;;
esac
